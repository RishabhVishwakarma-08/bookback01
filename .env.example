# MONGODB_URI: Connection string for MongoDB Atlas or local MongoDB.
# Required on Vercel; local development can omit it to use ./data/mongodb.
MONGODB_URI=""

# JWT_SECRET: Cryptographic secret for signing JWT authentication tokens (at least 16 characters).
# Required on Vercel so authentication works across serverless instances.
JWT_SECRET=""

# ADMIN_SETUP_KEY: One-time cryptographic setup key required to initialize the Super Admin and Team Admins via /setup.
# Leave blank in local dev to auto-generate a key in ./data/.setup_key (printed once to server console).
# Required on Vercel if no SUPER_ADMIN_EMAIL/PASSWORD are configured.
ADMIN_SETUP_KEY=""

# Optional: Pre-provision the 3 initial admin accounts automatically via environment variables (no hardcoded defaults).
# SUPER_ADMIN_NAME=""
# SUPER_ADMIN_EMAIL=""
# SUPER_ADMIN_COLLEGE_ID=""
# SUPER_ADMIN_PASSWORD=""
# TEAM_ADMIN_1_NAME=""
# TEAM_ADMIN_1_EMAIL=""
# TEAM_ADMIN_1_COLLEGE_ID=""
# TEAM_ADMIN_1_PASSWORD=""
# TEAM_ADMIN_2_NAME=""
# TEAM_ADMIN_2_EMAIL=""
# TEAM_ADMIN_2_COLLEGE_ID=""
# TEAM_ADMIN_2_PASSWORD=""

# CLIENT_ORIGIN: Allowed CORS origin for the frontend client.
CLIENT_ORIGIN="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
